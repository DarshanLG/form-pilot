{
  "name": "formpilot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FormPilot API: profile, resume/cover letter, runs, user corrections",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "mongodb": "6.12.0",
    "multer": "2.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
